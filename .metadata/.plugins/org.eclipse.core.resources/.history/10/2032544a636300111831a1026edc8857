package pages;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;
import Locators.*;

import utilities.Param;

public class YoutubePage {

	@FindBy(xpath=Locators.YtLogo)
	WebElement YtLogo;

	@FindBy(xpath=Locators.YtSearchBar)
	WebElement YtSearchBar;

	@FindBy(xpath=Locators.SearchBtn)
	WebElement SearchBtn;

	WebDriver driver;
	public YoutubePage(Param objParam){
		driver = objParam.driver;
		PageFactory.initElements(driver,this);
	}

	public void navigateToYoutube(Param objParam) {
		try {
			objParam.webActions.navigateToPage(objParam, BASE_URL, "Yt is opened");
			System.out.println(utilities.DBConnection.retriveDataFromDB("username"));
		}
		catch(Exception e) {
			objParam.reportEvents.eventCompleted("FAIL", "navigateToYoutube");
		}

	}

	public void logoIsDisplayed(Param objParam) {
		try{
			objParam.webActions.isDisplayed(objParam, YtLogo, "Youtube Logo is displayed");
		}
		catch(Exception e) {
			objParam.reportEvents.eventCompleted("FAIL", "logoIsDisplayed");
		}
	}

	public void searchForVideo(Param objParam) {
		try {
			objParam.webActions.setField(objParam, YtSearchBar, "News", "Youtube Search Bar");
			objParam.webActions.clickElement(objParam, SearchBtn, "Search button");
		}
		catch(Exception e) {
			objParam.reportEvents.eventCompleted("FAIL", "searchForVideo");
		}
	}
}
